# ============================================================================
# AI Research Assistant — environment template.
# Copy to `.env` (backend reads backend/.env or the process environment).
# Never commit a real .env. All values below are placeholders/safe defaults.
# ============================================================================

# --- General -----------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
# REQUIRED in production: 32+ random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
# Comma-separated list of allowed browser origins (your Vercel URL in production). No "*" in production.
CORS_ORIGINS=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Local zero-setup default (SQLite; vector search runs in NumPy):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL + pgvector (recommended; matches docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://ara:ara_dev_password@localhost:5432/ara
# Provider URLs like postgres://... or postgresql://... are accepted and converted automatically.
EMBEDDING_DIM=384                   # must match the embedding model; fixed in the pgvector column at migration time

# --- Auth --------------------------------------------------------------------
SESSION_EXPIRE_MINUTES=10080        # 7 days
COOKIE_SECURE=false                 # set true in production (HTTPS)
COOKIE_SAMESITE=lax
REGISTRATION_ENABLED=true
MIN_PASSWORD_LENGTH=10

# --- Rate limiting (per process; per client IP) -------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30

# --- File storage ------------------------------------------------------------
STORAGE_BACKEND=local               # local | s3   (use s3 on hosts with an ephemeral disk, e.g. Render free)
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
# S3-compatible object storage (Cloudflare R2, Backblaze B2, Supabase Storage, AWS S3). Needs requirements-s3.txt.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- Embeddings --------------------------------------------------------------
# sentence-transformers (local, default; needs requirements-ml.txt) | ollama | hash (offline/test only)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_OLLAMA_MODEL=             # only for EMBEDDING_PROVIDER=ollama (its dimension must equal EMBEDDING_DIM)

# --- LLM ---------------------------------------------------------------------
# groq (hosted) | ollama (local) | mock (deterministic offline demo/tests)
LLM_PROVIDER=ollama
# No model id is hard-coded in the app. Set one that exists for your provider:
#   Ollama: a name from `ollama list`;  Groq: an id from the model list in https://console.groq.com
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1500
GROQ_API_KEY=                       # secret: server-side only, never sent to the browser
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434
ALLOW_MOCK_PROVIDER=true            # set false in production

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.25      # cosine; tuned for all-MiniLM-L6-v2 (use ~0.1 for the lexical `hash` embedder)
RETRIEVAL_HYBRID=true
CONTEXT_TOKEN_BUDGET=6000
HISTORY_TURNS=6

# --- Background jobs ---------------------------------------------------------
# embedded: worker runs inside the API process (free tiers / dev) | external: run `python -m app.jobs.worker` | disabled
JOB_RUNNER=embedded
JOB_MAX_ATTEMPTS=3
JOB_POLL_INTERVAL_SECONDS=2
JOB_STALE_SECONDS=600
JOB_RETRY_BACKOFF_SECONDS=5

# --- Frontend (set in frontend/.env.local or the Vercel dashboard) -------------
# BACKEND_URL=http://localhost:8000   # where the Next.js server proxies /api/* to
